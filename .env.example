# Copy to .env and adjust before `docker compose up -d --build`.
# Values here override the defaults in docker-compose.yml.

# Postgres (internal container credentials)
POSTGRES_USER=desauser
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=desa

# API auth signing key — MUST be replaced with a long random string.
JWT_SECRET=change-this-in-production

# Metabase embed base URL baked into the web + admin builds.
VITE_METABASE_URL=https://bi-embed.desapalasari.my.id

# Copy to .env and adjust before `docker compose up -d --build`.
# Values here override the defaults in docker-compose.yml.

# Postgres (internal container credentials)
POSTGRES_USER=desauser
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=desa

# API auth signing key — MUST be replaced with a long random string.
JWT_SECRET=change-this-in-production

# Metabase embed base URL baked into the web + admin builds.
VITE_METABASE_URL=https://bi-embed.desapalasari.my.id

# Runtime config for the web + admin SPAs. These are injected into /env.js when
# the container starts, so changing them only needs `docker compose up -d`
# (no image rebuild). The web build expects the full API path (…/api/v1); the
# admin build expects the API origin only (it appends /api/v1 itself).
VITE_API_BASE_URL=https://api.desapalasari.my.id/api/v1
# Admin API origin (optional; defaults to the value above without the path).
VITE_API_BASE_URL_ADMIN=https://api.desapalasari.my.id

# Web feature flags (runtime).
VITE_FEATURE_GALLERY_PUBLIC=true
VITE_FEATURE_BERITA_SEARCH=false
VITE_FEATURE_INFOGRAPHIC_SORT=false

# =============================================================================
# Desa API Management - Environment Variables Example
# =============================================================================
# Copy this file to .env and update the values according to your environment
# Note: This application primarily uses TOML config files (config.toml)
# These environment variables can override TOML settings when needed
# =============================================================================

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------

# Application name
APP_NAME=desa-api

# Application version
APP_VERSION=1.0.0

# HTTP server address and port
APP_HTTP_ADDR=:8080

# Timezone for the application (e.g., Asia/Jakarta, UTC, America/New_York)
APP_TIMEZONE=Asia/Jakarta

# HTTP server timeouts
APP_READ_TIMEOUT=15s
APP_WRITE_TIMEOUT=15s
APP_IDLE_TIMEOUT=60s

# Proxy URL (optional, leave empty if not using proxy)
# APP_PROXY_URL=http://proxy.example.com:8080

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------

# PostgreSQL connection string
# Format: postgres://username:password@host:port/database?sslmode=disable
POSTGRES_DSN=postgres://desa_user:desa_pass@localhost:5432/desa_db?sslmode=disable

# Database connection pool settings
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=5
POSTGRES_CONN_MAX_LIFETIME=5m

# Individual database connection parameters (alternative to DSN)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=desa_db
# DB_USER=desa_user
# DB_PASSWORD=desa_pass

# -----------------------------------------------------------------------------
# JWT Authentication Configuration
# -----------------------------------------------------------------------------

# JWT secret key for signing tokens
# IMPORTANT: Change this to a strong, random secret in production!
# Generate with: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-this-in-production-use-strong-random-value

# JWT token expiration duration (e.g., 24h, 1h, 30m)
JWT_EXPIRATION=24h

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------

# Comma-separated list of allowed origins for CORS
# Examples:
#   Development: http://localhost:3000,http://localhost:5173
#   Production: https://desa.example.com,https://www.desa.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# Rate Limiting Configuration
# -----------------------------------------------------------------------------

# Rate limit for authentication endpoints (login, register)
# Lower limit to prevent brute force attacks
RATELIMIT_AUTH_REQUESTS_PER_MINUTE=5

# Rate limit for public endpoints (no authentication required)
RATELIMIT_PUBLIC_REQUESTS_PER_MINUTE=100

# Rate limit for protected endpoints (authentication required)
RATELIMIT_PROTECTED_REQUESTS_PER_MINUTE=30

# -----------------------------------------------------------------------------
# File Upload Configuration
# -----------------------------------------------------------------------------

# Maximum image file size in megabytes
FILEUPLOAD_MAX_IMAGE_SIZE_MB=10

# Maximum document file size in megabytes
FILEUPLOAD_MAX_DOCUMENT_SIZE_MB=50

# Public files exposed through /uploads/*
FILEUPLOAD_UPLOAD_PUBLIC_DIRECTORY=./uploads/public

# Private files served only through authorized handlers
FILEUPLOAD_UPLOAD_PRIVATE_DIRECTORY=./uploads/private

# PPID document storage
FILEUPLOAD_UPLOAD_PPID_DIRECTORY=./uploads/ppid

# -----------------------------------------------------------------------------
# Gallery Configuration
# -----------------------------------------------------------------------------

GALLERY_THUMBNAIL_MAX_WIDTH=400
GALLERY_THUMBNAIL_MAX_HEIGHT=400
GALLERY_THUMBNAIL_QUALITY=80
GALLERY_IMAGE_MAX_SIZE_MB=10
GALLERY_VIDEO_MAX_SIZE_MB=100
GALLERY_BULK_UPLOAD_MAX_FILES=20
GALLERY_BULK_UPLOAD_MAX_TOTAL_MB=250
GALLERY_FFMPEG_PATH=ffmpeg
GALLERY_FFPROBE_PATH=ffprobe
GALLERY_VIDEO_THUMBNAIL_FRAME_SECONDS=1

# -----------------------------------------------------------------------------
# Backup Configuration
# -----------------------------------------------------------------------------

# Directory for storing database backups
# Ensure this directory exists and has proper write permissions
BACKUP_DIRECTORY=./backups

# Backup retention period (optional)
# BACKUP_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# OpenTelemetry Configuration
# -----------------------------------------------------------------------------

# Enable OpenTelemetry metrics collection
OTEL_METRIC=false

# Enable OpenTelemetry distributed tracing
OTEL_TRACE=false

# Enable OpenTelemetry logging
OTEL_LOG=false

# OpenTelemetry collector endpoint (if enabled)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# OpenTelemetry service name
# OTEL_SERVICE_NAME=desa-api

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log format: json, text
# LOG_FORMAT=json

# Log output: stdout, stderr, file
# LOG_OUTPUT=stdout

# Log file path (if LOG_OUTPUT=file)
# LOG_FILE_PATH=./logs/app.log

# -----------------------------------------------------------------------------
# Debug Configuration
# -----------------------------------------------------------------------------

# Profiler address for pprof debugging
# Access at http://localhost:6060/debug/pprof/
DEBUG_PROFILER_ADDR=localhost:6060

# Enable debug mode (more verbose logging, stack traces, etc.)
# DEBUG_MODE=false

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------

# Enable HTTPS (requires certificate files)
# HTTPS_ENABLED=false

# Path to TLS certificate file
# TLS_CERT_FILE=./certs/server.crt

# Path to TLS private key file
# TLS_KEY_FILE=./certs/server.key

# -----------------------------------------------------------------------------
# External Services (Optional)
# -----------------------------------------------------------------------------

# Email service configuration (for PPID document notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Village Administration
SMTP_FROM_EMAIL=noreply@desa.example.com

# Redis configuration (for caching, sessions, etc.)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------

# Application environment: development, staging, production
ENVIRONMENT=development

# Enable graceful shutdown timeout
# SHUTDOWN_TIMEOUT=30s

# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
# 1. Never commit .env file to version control
# 2. Keep .env.example updated when adding new environment variables
# 3. Use strong, random values for secrets in production
# 4. Ensure proper file permissions for sensitive files (chmod 600 .env)
# 5. Consider using a secrets management service in production
# 6. Validate all environment variables on application startup
# =============================================================================
